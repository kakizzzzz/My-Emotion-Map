{
  "name": "my-emotion-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p supabase/functions/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:size": "node scripts/check-source-size.mjs",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check:architecture": "npm run check:size && npm run check:imports",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:architecture && npm run build",
    "check:all": "npm run check && npm run test:e2e",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "exifr": "^7.1.3",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.1",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.111.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
